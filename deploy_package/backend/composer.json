{
  "name": "pandp/petshop-backend",
  "description": "Production e-commerce backend and Uber Eats integration for P and P Pet Shop",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Uber\\": "integrations/Uber/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
