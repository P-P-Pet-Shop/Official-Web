# P and P Pet Shop - Production Environment Configuration

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pandppetshop.lk
API_PREFIX=/api/v1
TIMEZONE=Asia/Colombo
CURRENCY=LKR
CURRENCY_SYMBOL=Rs.

# Database (cPanel MySQL credentials)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pandp_petshop
DB_USER=pandp_dbuser
DB_PASS=YourStrongDatabasePasswordHere
DB_CHARSET=utf8mb4

# Security
JWT_SECRET=generate-a-secure-64-character-hex-key-here
SESSION_LIFETIME=7200
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# Uber Eats Integration
UBER_ENVIRONMENT=sandbox
UBER_CLIENT_ID=your-uber-client-id
UBER_CLIENT_SECRET=your-uber-client-secret
UBER_REDIRECT_URI=https://pandppetshop.lk/api/v1/auth/uber/callback
UBER_STORE_ID=your-uber-store-id
UBER_ACCESS_TOKEN=
UBER_REFRESH_TOKEN=
UBER_WEBHOOK_SIGNING_KEY=your-uber-webhook-signing-key

# Uber Capabilities (Disabled until officially approved by Uber)
UBER_EXTERNAL_ORDER_INJECTION_APPROVED=false
UBER_DIRECT_ENABLED=false
