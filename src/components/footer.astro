---
import logo from '../assets/logo.png';
import '../styles/global.css';

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'Service', href: '/services' },
  { name: 'Contact', href: '/contact' }
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#F8F9FA] pt-16 pb-6 px-6 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      
      <div class="flex flex-col items-start max-w-sm">
        <img 
          src={logo.src} 
          alt="P&P Pet Shop Logo" 
          class="h-16 w-auto mb-6 object-contain"
        />
        <p class="text-gray-500 text-sm leading-relaxed">
          Your trusted partner in pet parenting. Providing the best care, food, and companions in Sri Lanka.
        </p>
      </div>

      <div class="md:pl-10">
        <h3 class="text-lg font-bold text-black mb-6">Quick Links</h3>
        <ul class="flex flex-col space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-gray-800 font-medium hover:text-[#D9782D] transition-colors text-[15px]"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-bold text-black mb-6">Delivery Partners</h3>
        <div class="flex flex-col space-y-4">
          
          <a 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between bg-[#00B14F] text-white font-bold px-6 py-3 rounded-xl hover:bg-green-700 transition-colors shadow-sm max-w-[220px]"
          >
            <span>Uber Eats</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between bg-[#F4D03F] text-black font-bold px-6 py-3 rounded-xl hover:bg-[#e0be35] transition-colors shadow-sm max-w-[220px]"
          >
            <span>PickMe Food</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          
        </div>
      </div>

    </div>

    <div class="border-t border-gray-300 pt-6 flex justify-center">
      <p class="text-gray-600 text-sm font-semibold text-center">
        &copy; {currentYear} P & P PET SHOP Developed by 
        <a 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="underline hover:text-black transition-colors"
        >
          S JAY Web Solutions (Pvt) Ltd
        </a>
      </p>
    </div>

  </div>
</footer>