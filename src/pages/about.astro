---
// Import your components and assets
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import aboutPic from '../assets/aboutpic.png';
import aboutDetails from '../assets/aboutdetails.jpg';
import g1 from '../assets/g1.jpg';
import g2 from '../assets/g2.jpg';
import g3 from '../assets/g3.jpg';
import g4 from '../assets/g4.jpg';


const reasons = [
  {
    title: "Love for Animals",
    desc: "Every recommendation we make is for your pet's well-being first.",
    iconColor: "text-[#E369B2]", // Pink heart
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />'
  },
  {
    title: "Quality-First Approach",
    desc: "Only trusted brands and safe products for your beloved pets.",
    iconColor: "text-[#F1C40F]", // Yellow star
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />'
  },
  {
    title: "Community-Focused",
    desc: "Supporting and growing the local pet-loving community.",
    iconColor: "text-[#374151]", // Dark Gray people
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />'
  }
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About Us - P&P Pet Shop</title>
  </head>
  <body class="bg-white font-sans antialiased text-gray-900 overflow-x-hidden">
    
    <Navbar />

    <main class="max-w-7xl mx-auto px-6 pt-16 pb-24 lg:pt-24">
      
      <section class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8">
        
        <div class="flex-1 flex flex-col items-start space-y-6 max-w-xl z-10">
          <h2 class="text-[#D9782D] text-3xl md:text-4xl font-extrabold uppercase tracking-wide">
            About Us
          </h2>
          
          <h1 class="text-4xl lg:text-5xl font-extrabold leading-tight text-black">
            Helping Every Pet Live a Healthier , <span class="text-[#D9782D]">Happier</span> Life.
          </h1>
          
          <p class="text-lg text-gray-500 font-medium leading-relaxed max-w-md">
            Quality pet food, accessories, and expert advice in Mount Lavinia
          </p>
        </div>

        <div class="flex-1 w-full relative flex justify-center lg:justify-end mt-10 lg:mt-0">
          
          <div class="absolute top-0 right-0 w-full sm:w-[130%] h-full bg-[#F2F6DC] rounded-tl-[160px] rounded-bl-[90px] rounded-br-[30px] -z-10 translate-x-4 lg:translate-x-10 transform scale-105 origin-right"></div>
          
          <img 
            src={aboutPic.src} 
            alt="A happy dog, cat, and rabbit sitting together" 
            class="relative z-10 w-full max-w-lg lg:max-w-xl object-contain drop-shadow-md"
          />
          
        </div>

      </section>
      <!-- Our Story Section -->
<section class="mt-16 lg:mt-24 relative z-20">
  <div class="bg-white rounded-[2.5rem] shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-200 flex flex-col lg:flex-row overflow-hidden">
    
    <!-- Left Column: Image -->
    <div class="w-full lg:w-1/2 lg:shrink-0">
      <img 
        src={aboutDetails.src} 
        alt="P&P Pet Shop Opening Poster - Mount Lavinia" 
        class="w-full h-full object-cover object-center min-h-[300px] lg:min-h-[500px]"
      />
    </div>

    <!-- Right Column: Text Content -->
    <div class="w-full lg:w-1/2 p-8 sm:p-12 lg:p-16 flex flex-col justify-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-black mb-8 text-center">
        Our Story
      </h2>
      
      <div class="space-y-6 text-gray-700 font-medium leading-relaxed text-[15px] sm:text-base">
        <p>
          At P & P Pet Shop, our journey began with a simple love for animals and a desire to serve the growing community of pet lovers in Mount Lavinia. From humble beginnings, we've grown into a trusted name, offering carefully selected food, accessories, and care products for dogs, cats, birds, hamster, and more.
        </p>
        
        <p>
          Our store is more than just a pet supply shop — it's a place where pet parents find expert advice, friendly service, and a passion for happy, healthy animals. Every product on our shelves is chosen with care, and every customer is treated like family.
        </p>
        
        <p>
          Whether you're a first-time pet owner or a seasoned animal lover, we're here to support you every step of the way - because at P & P Pet Shop, your pet's well-being is our top priority.
        </p>
      </div>
    </div>

  </div>
</section>

<!-- Who We Are Section -->
<section class="max-w-4xl mx-auto px-6 py-20 text-center">
  <h2 class="text-3xl md:text-4xl font-extrabold text-black mb-8">
    Who We Are
  </h2>
  
  <div class="space-y-6 text-black font-medium leading-relaxed text-[15px] sm:text-base md:text-lg">
    <p>
      P & P Pet Shop is a locally owned and operated pet supply store located in the heart of Mount Lavinia. We specialize in providing high-quality products and trusted care essentials for all kinds of pets — from playful pups and curious kittens to chirping birds and cute hamsters.
    </p>
    
    <p>
      Backed by a team of passionate animal lovers, we're here to help every pet owner find exactly what they need to keep their companions happy, healthy, and loved.
    </p>
    
    <p>
      At P & P, it's not just about products — it's about building lasting relationships with our customers and their pets.
    </p>
  </div>
</section>

<!-- A Glimpse of Our Store Section -->
<section class="max-w-7xl mx-auto px-6 pb-24">
  <h2 class="text-2xl md:text-3xl font-bold text-[#D9782D] mb-8">
    A Glimpse of Our Store
  </h2>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
    <!-- Image 1 -->
    <div class="overflow-hidden bg-gray-100 aspect-[4/3] lg:aspect-square flex items-center justify-center">
      <img 
        src={g1.src} 
        alt="Bird seed and feeds on display" 
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
      />
    </div>
    
    <!-- Image 2 -->
    <div class="overflow-hidden bg-gray-100 aspect-[4/3] lg:aspect-square flex items-center justify-center">
      <img 
        src={g2.src} 
        alt="Manitoba bird food bags on shelves" 
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
      />
    </div>
    
    <!-- Image 3 -->
    <div class="overflow-hidden bg-gray-100 aspect-[4/3] lg:aspect-square flex items-center justify-center">
      <img 
        src={g3.src} 
        alt="Whiskas cat food varieties" 
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
      />
    </div>
    
    <!-- Image 4 -->
    <div class="overflow-hidden bg-gray-100 aspect-[4/3] lg:aspect-square flex items-center justify-center">
      <img 
        src={g4.src} 
        alt="Drools dog food bags on store shelves" 
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
      />
    </div>
  </div>
</section>

<!-- Why Pet Owners Choose Us Section -->
<section class="max-w-7xl mx-auto px-6 py-20">
  
  <h2 class="text-3xl md:text-4xl font-extrabold text-black text-center mb-12">
    Why Pet Owners Choose Us
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {reasons.map((reason) => (
      <div class="bg-white border border-gray-100 rounded-[2.5rem] p-10 text-center shadow-[0_8px_30px_rgb(0,0,0,0.06)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.1)] transition-shadow duration-300">
        
        <!-- Icon Wrapper -->
        <div class="w-20 h-20 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-6">
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke-width="2" 
            stroke="currentColor" 
            class={`w-9 h-9 ${reason.iconColor}`}
            set:html={reason.iconPath}
          />
        </div>

        <!-- Text Content -->
        <h3 class="text-xl font-extrabold text-black mb-3">
          {reason.title}
        </h3>
        <p class="text-gray-500 text-[15px] leading-relaxed font-medium px-2">
          {reason.desc}
        </p>
        
      </div>
    ))}
  </div>
  
</section>

    </main>

    <Footer />
    
  </body>
</html>