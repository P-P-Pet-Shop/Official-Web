---
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import contactBanner from '../assets/contactbanner.png';
import contactCard from '../assets/contactcard.jpg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Us - P&P Pet Shop</title>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  </head>
  <body class="bg-gray-100 font-sans text-gray-900">
    <Navbar />

    <main>
      <section class="relative w-full h-[500px] flex items-center mt-[-100px] pt-[100px]">
        <div class="absolute inset-0 -z-10">
          <img src={contactBanner.src} class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/50 to-transparent"></div>
        </div>
        <div class="max-w-7xl mx-auto px-6 w-full">
          <h1 class="text-6xl font-extrabold text-[#E6A97A] mb-4">Contact Us</h1>
          <p class="text-xl text-gray-800 font-medium max-w-sm">
            We’re here to help! Reach out to us for any questions or for pet care advice.
          </p>
        </div>
      </section>

      <section class="max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10">
        
        <div class="bg-white p-8 rounded-[2.5rem] shadow-sm">
          <h2 class="text-2xl font-bold mb-8">Send us a message</h2>
          
          <form id="contact-form" class="space-y-6">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold mb-2">First Name</label>
                <input type="text" name="first_name" placeholder="First Name" class="w-full p-4 rounded-xl bg-gray-100 border-none" required />
              </div>
              <div>
                <label class="block text-sm font-semibold mb-2">Last Name</label>
                <input type="text" name="last_name" placeholder="Last Name" class="w-full p-4 rounded-xl bg-gray-100 border-none" required />
              </div>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2">Email</label>
              <input type="email" name="user_email" class="w-full p-4 rounded-xl bg-gray-100 border-none" required />
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2">Message</label>
              <textarea name="message" rows="5" class="w-full p-4 rounded-xl bg-gray-100 border-none" required></textarea>
            </div>
            
            <button id="submit-btn" type="submit" class="bg-[#E6A97A] text-white font-bold px-10 py-4 rounded-full hover:bg-orange-600 transition">
              Send Message
            </button>
            <p id="form-status" class="hidden text-sm font-bold mt-4"></p>
          </form>
        </div>

      <div class="space-y-8">
  <div class="bg-white rounded-[2.5rem] shadow-sm overflow-hidden">
    <!-- Banner Image -->
    <div class="relative">
      <img src={contactCard.src} class="w-full h-64 object-cover" />
      <div class="absolute bottom-6 left-6 text-white">
        <span class="inline-block bg-white/20 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full mb-2">
          Pet Store
        </span>
        <h3 class="text-2xl font-bold">P & P Pet Shop</h3>
      </div>
    </div>

    <!-- Info List -->
    <div class="p-8 space-y-6">
      <div class="flex items-center gap-4">
        <div class="bg-orange-50 p-4 rounded-full text-[#E6A97A]">📍</div>
        <p class="text-gray-700 font-medium">No 22, Galle Road, Mount Lavinia</p>
      </div>
      
      <div class="flex items-center gap-4">
        <div class="bg-green-50 p-4 rounded-full text-green-600">📞</div>
        <p class="text-gray-700 font-medium">+94 77 340 5315</p>
      </div>

      <!-- Updated Facebook Link -->
      <a href="https://web.facebook.com/pandppetshop" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group">
        <div class="bg-blue-50 p-4 rounded-full text-blue-600 font-bold w-14 h-14 flex items-center justify-center text-xl transition-transform group-hover:scale-105">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </div>
        <p class="text-gray-700 font-medium group-hover:text-blue-600 transition-colors">Follow us on Facebook</p>
      </a>

      <!-- Updated Call Button -->
      <a href="tel:+94773405315" class="block w-full bg-[#63B3ED] text-center text-white font-bold py-4 rounded-2xl hover:bg-blue-400 transition mt-6">
        Call Now
      </a>
    </div>
  </div>
</div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (function() {
        // Replace with your actual Public Key from EmailJS
        emailjs.init("YOUR_PUBLIC_KEY");
      })();

      const form = document.getElementById('contact-form');
      const statusMsg = document.getElementById('form-status');
      const submitBtn = document.getElementById('submit-btn');

      form.addEventListener('submit', function(event) {
        event.preventDefault();
        
        submitBtn.innerText = "Sending...";
        submitBtn.disabled = true;

        // Replace with your Service ID and Template ID
        emailjs.sendForm('YOUR_SERVICE_ID', 'YOUR_TEMPLATE_ID', this)
          .then(function() {
            statusMsg.innerText = "Message sent successfully!";
            statusMsg.classList.remove('hidden', 'text-red-500');
            statusMsg.classList.add('text-green-500');
            form.reset();
            submitBtn.innerText = "Send Message";
            submitBtn.disabled = false;
          }, function(error) {
            statusMsg.innerText = "Failed to send message. Please try again.";
            statusMsg.classList.remove('hidden', 'text-green-500');
            statusMsg.classList.add('text-red-500');
            submitBtn.innerText = "Send Message";
            submitBtn.disabled = false;
          });
      });
    </script>
  </body>
</html>