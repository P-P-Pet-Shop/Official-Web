---
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shopping Cart - P&P Pet Shop</title>
  </head>
  <body class="bg-gray-50 font-sans text-gray-900 min-h-screen flex flex-col">
    <Navbar />

    <main class="flex-1 max-w-7xl mx-auto px-6 pt-28 pb-20 w-full">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-8 text-gray-900">
        Your Shopping <span class="text-[#D9782D]">Cart</span>
      </h1>

      <div id="cart-container" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items List (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
          <div id="cart-items-wrapper" class="space-y-4">
            <!-- Dynamically populated by client-side script -->
          </div>

          <!-- Empty Cart State -->
          <div id="empty-cart-view" class="hidden bg-white rounded-[2.5rem] p-12 text-center border border-gray-100 shadow-sm">
            <svg class="w-20 h-20 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <h2 class="text-2xl font-bold mb-2">Your cart is currently empty</h2>
            <p class="text-gray-500 text-sm max-w-md mx-auto mb-6">
              Looks like you haven't added any pet food or accessories yet. Explore our shop to find the best treats and supplies for your companion!
            </p>
            <a href="/shop" class="inline-flex items-center gap-2 bg-[#D9782D] hover:bg-[#b86120] text-white font-bold px-8 py-3.5 rounded-full transition shadow-sm">
              Explore Shop
            </a>
          </div>
        </div>

        <!-- Order Summary Sidebar (1 Col) -->
        <div id="order-summary-box" class="bg-white rounded-[2.5rem] p-6 md:p-8 border border-gray-100 shadow-sm h-fit space-y-6">
          <h2 class="text-xl font-extrabold text-gray-900 border-b border-gray-100 pb-4">
            Order Summary
          </h2>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between text-gray-600">
              <span>Items Subtotal:</span>
              <span id="summary-subtotal" class="font-bold text-gray-900">Rs. 0.00</span>
            </div>

            <!-- District Selection for Delivery Calculation -->
            <div class="pt-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5">
                Delivery District:
              </label>
              <select id="district-select" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-semibold focus:outline-none focus:border-[#D9782D]">
                <option value="Colombo" selected>Colombo (Rs. 350 / Free over 15k)</option>
                <option value="Gampaha">Gampaha (Rs. 450)</option>
                <option value="Kalutara">Kalutara (Rs. 450)</option>
                <option value="Kandy">Kandy (Rs. 650)</option>
                <option value="Galle">Galle (Rs. 650)</option>
                <option value="Matara">Matara (Rs. 650)</option>
                <option value="Kurunegala">Kurunegala (Rs. 650)</option>
                <option value="Other">Other Outstation District (Rs. 650)</option>
              </select>
            </div>

            <div class="flex justify-between text-gray-600 pt-2">
              <span>Delivery Charge:</span>
              <span id="summary-delivery" class="font-bold text-green-700">Rs. 350.00</span>
            </div>

            <div class="border-t border-gray-100 pt-4 flex justify-between items-baseline">
              <span class="text-base font-bold text-gray-900">Estimated Total:</span>
              <span id="summary-total" class="text-2xl font-black text-[#D9782D]">Rs. 0.00</span>
            </div>
            <p class="text-[11px] text-gray-400 italic">
              *All prices verified and calculated securely on the server.
            </p>
          </div>

          <a 
            href="/checkout" 
            id="checkout-cta-btn"
            class="block w-full bg-[#00B14F] hover:bg-green-700 text-white font-bold text-center py-4 rounded-2xl transition shadow-sm active:scale-95"
          >
            Proceed to Checkout
          </a>

          <div class="space-y-2 pt-2 text-xs text-gray-500 border-t border-gray-100">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Cash on Delivery & Bank Transfer Accepted</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#D9782D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <span>Safe & Verified Order Processing</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<script>
  import { getCart, updateQuantity, removeFromCart, type CartItem } from '../scripts/cart';
  import { apiRequest } from '../scripts/api';

  async function renderCart() {
    const cart = getCart();
    const itemsWrapper = document.getElementById('cart-items-wrapper');
    const emptyView = document.getElementById('empty-cart-view');
    const summaryBox = document.getElementById('order-summary-box');
    const districtSelect = document.getElementById('district-select') as HTMLSelectElement;
    const selectedDistrict = districtSelect?.value || 'Colombo';

    if (cart.length === 0) {
      if (itemsWrapper) itemsWrapper.innerHTML = '';
      if (emptyView) emptyView.classList.remove('hidden');
      if (summaryBox) summaryBox.classList.add('hidden');
      return;
    }

    if (emptyView) emptyView.classList.add('hidden');
    if (summaryBox) summaryBox.classList.remove('hidden');

    // Call server to validate prices and compute total
    const validationRes = await apiRequest('/cart/validate', {
      method: 'POST',
      body: JSON.stringify({
        items: cart.map(item => ({
          product_id: item.productId,
          variant_id: item.variantId,
          quantity: item.quantity
        })),
        district: selectedDistrict
      })
    });

    const data = validationRes.data || {};
    const items = data.items || cart.map(c => ({
      product_id: c.productId,
      variant_id: c.variantId,
      product_name: c.name,
      variant_name: c.variantName,
      unit_price: c.price,
      quantity: c.quantity,
      image_url: c.image,
      subtotal: c.price * c.quantity
    }));

    if (itemsWrapper) {
      itemsWrapper.innerHTML = items.map((item: any) => `
        <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm flex flex-col sm:flex-row items-center gap-5">
          <img src="${item.image_url || '/assets/100002.png'}" alt="${item.product_name}" class="w-24 h-24 object-cover rounded-2xl bg-gray-50 shrink-0" />
          <div class="flex-1 space-y-1 text-center sm:text-left">
            <h3 class="font-bold text-gray-900 text-base">${item.product_name}</h3>
            ${item.variant_name ? `<span class="inline-block bg-gray-100 text-gray-600 text-xs px-2.5 py-0.5 rounded-full font-medium">${item.variant_name}</span>` : ''}
            <div class="text-sm font-semibold text-gray-500">Unit: Rs. ${(item.unit_price).toLocaleString('en-US', { minimumFractionDigits: 2 })}</div>
          </div>
          
          <!-- Quantity Controls -->
          <div class="flex items-center gap-4">
            <div class="flex items-center border border-gray-200 rounded-xl p-1 bg-gray-50">
              <button class="cart-minus w-8 h-8 flex items-center justify-center font-bold text-gray-600 hover:bg-white rounded-lg transition" data-id="${item.product_id}" data-variant="${item.variant_id ?? ''}">-</button>
              <span class="w-10 text-center text-xs font-black">${item.quantity}</span>
              <button class="cart-plus w-8 h-8 flex items-center justify-center font-bold text-gray-600 hover:bg-white rounded-lg transition" data-id="${item.product_id}" data-variant="${item.variant_id ?? ''}">+</button>
            </div>
            
            <div class="text-right w-24">
              <div class="text-base font-black text-gray-900">Rs. ${(item.subtotal || item.unit_price * item.quantity).toLocaleString('en-US', { minimumFractionDigits: 2 })}</div>
            </div>

            <button class="cart-remove text-gray-400 hover:text-red-500 p-2 transition" data-id="${item.product_id}" data-variant="${item.variant_id ?? ''}" title="Remove item">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          </div>
        </div>
      `).join('');

      // Wire up buttons
      itemsWrapper.querySelectorAll('.cart-minus').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = e.currentTarget as HTMLElement;
          const pId = parseInt(t.dataset.id || '0', 10);
          const vId = t.dataset.variant ? parseInt(t.dataset.variant, 10) : null;
          const currentItem = cart.find(c => c.productId === pId && (c.variantId ?? null) === vId);
          if (currentItem) {
            updateQuantity(pId, vId, currentItem.quantity - 1);
            renderCart();
          }
        });
      });

      itemsWrapper.querySelectorAll('.cart-plus').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = e.currentTarget as HTMLElement;
          const pId = parseInt(t.dataset.id || '0', 10);
          const vId = t.dataset.variant ? parseInt(t.dataset.variant, 10) : null;
          const currentItem = cart.find(c => c.productId === pId && (c.variantId ?? null) === vId);
          if (currentItem) {
            updateQuantity(pId, vId, currentItem.quantity + 1);
            renderCart();
          }
        });
      });

      itemsWrapper.querySelectorAll('.cart-remove').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = e.currentTarget as HTMLElement;
          const pId = parseInt(t.dataset.id || '0', 10);
          const vId = t.dataset.variant ? parseInt(t.dataset.variant, 10) : null;
          removeFromCart(pId, vId);
          renderCart();
        });
      });
    }

    // Update Summary Box
    const subtotal = data.subtotal ?? cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);
    const delivery = data.delivery_fee ?? (subtotal >= 15000 ? 0 : 350);
    const total = data.total ?? (subtotal + delivery);

    const subtotalEl = document.getElementById('summary-subtotal');
    const deliveryEl = document.getElementById('summary-delivery');
    const totalEl = document.getElementById('summary-total');

    if (subtotalEl) subtotalEl.textContent = `Rs. ${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
    if (deliveryEl) deliveryEl.textContent = delivery === 0 ? 'FREE' : `Rs. ${delivery.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
    if (totalEl) totalEl.textContent = `Rs. ${total.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderCart();
    const districtSelect = document.getElementById('district-select');
    districtSelect?.addEventListener('change', renderCart);
  });
</script>

