---
// Import your components and assets
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import dogsHero from '../assets/herodogs.png';
import puppyImg from '../assets/puppy.jpg';
import kittenImg from '../assets/kitten.jpg';
import bird2Img from '../assets/bird2.jpg'; // The mockup shows a puppy here, but you'll want a bird image!
import hamsterImg from '../assets/hamster.jpg';
import frenchBulldogImg from '../assets/french-bulldog.jpg';
import yellowLogo from '../assets/yellowlogo.jpg';



const companions = [
  {
    title: "Playful Puppies",
    tag: "Puppies",
    desc: "Find your perfect furry friend - healthy, playful puppies ready to join your family today!",
    bgClass: "bg-[#EAE8D3]",
    img: puppyImg
  },
  {
    title: "Cuddly Kittens",
    tag: "Kittens",
    desc: "Adorable, well-cared-for kittens looking for loving forever homes- meet your new purring companion today!",
    bgClass: "bg-[#C4DACB]",
    img: kittenImg
  },
  {
    title: "Chirpy Birds",
    tag: "Birds",
    desc: "Bring home vibrant, chirpy companions hand-raised birds that brighten every day with song and color!",
    bgClass: "bg-[#D2F6EA]",
    img: bird2Img
  },
  {
    title: "Tiny Hamsters",
    tag: "Hamsters",
    desc: "Cute, cuddly hamsters perfect for small spaces and big hearts ideal starter pets for all ages!",
    bgClass: "bg-[#F3E5E4]",
    img: hamsterImg
  }
];

const features = [
  {
    title: "Trusted by hundreds <br/> of pet parents",
    iconColor: "text-[#E369B2]", // Pink
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />'
  },
  {
    title: "Wide range of pets, <br/> food, and accessories",
    iconColor: "text-[#43A047]", // Green
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />'
  },
  {
    title: "Clean, safe, and <br/> loving environment",
    iconColor: "text-[#E67E22]", // Orange
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />'
  },
  {
    title: "Online Shopping and <br/> Delivery available",
    iconColor: "text-[#C27365]", // Brownish Red
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />'
  }
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>P&P Pet Shop</title>
  </head>
  <body class="bg-white font-sans antialiased text-gray-900">
    
    <Navbar />

    <main class="max-w-7xl mx-auto px-6 pt-12 pb-24 lg:pt-20">
      <section class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8">
        
        <div class="flex-1 flex flex-col items-start space-y-6 max-w-xl">
          <h1 class="text-5xl lg:text-[4rem] font-extrabold leading-tight tracking-tight">
            Your pet’s <br />
            <span class="text-[#D9782D]">happiness</span> starts <br />
            here.
          </h1>
          
          <p class="text-lg text-gray-800 font-medium leading-relaxed max-w-md">
            Discover a world of joy for your furry, feathery, and scaly friends right here in Sri Lanka.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-4">
            <a href="/contact" class="flex items-center gap-2 bg-[#D9782D] text-white px-7 py-3.5 rounded-full font-bold hover:bg-[#c26a26] transition-colors shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              Contact Us
            </a>
            
            <a href="/gallery" class="flex items-center gap-2 bg-white text-black border border-gray-200 px-7 py-3.5 rounded-full font-bold hover:bg-gray-50 transition-colors shadow-sm">
              Explore Pets
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>

        <div class="flex-1 w-full relative max-w-2xl lg:ml-auto mt-8 lg:mt-0">
          
          <img 
            src={dogsHero.src} 
            alt="Two happy dogs running outdoors" 
            class="w-full h-auto object-cover rounded-[2.5rem] shadow-sm"
          />

          <div class="absolute -bottom-6 left-6 sm:left-12 bg-white rounded-2xl p-4 pr-6 flex items-center gap-4 shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-gray-100">
            <div class="bg-[#E5F3EB] p-2.5 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-[#4F9E73]">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-extrabold text-sm text-black">4.9/5 Rating</span>
              <span class="text-xs text-gray-500 font-medium mt-0.5">From happy pet parents</span>
            </div>
          </div>
          
        </div>

      </section>

      <!-- Meet Our Companions Section -->
<section class="max-w-7xl mx-auto px-6 py-16">
  <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 text-black">
    Meet Our <span class="text-[#519B70]">Companions</span>
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {companions.map((pet) => (
      <div class={`rounded-[2rem] p-4 ${pet.bgClass} flex flex-col h-full`}>
        <!-- Image & Tag -->
        <div class="relative w-full aspect-[4/3] mb-5">
          <img 
            src={pet.img.src} 
            alt={pet.title} 
            class="w-full h-full object-cover rounded-3xl"
          />
          <span class="absolute top-3 right-3 bg-white text-black text-xs font-bold px-3 py-1 rounded-full shadow-sm">
            {pet.tag}
          </span>
        </div>
        
        <!-- Content -->
        <div class="px-2 pb-2 flex-1 flex flex-col">
          <h3 class="text-xl font-extrabold text-black mb-3">{pet.title}</h3>
          <p class="text-gray-800 text-sm leading-relaxed font-medium">
            {pet.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Order Pet Foods Online Section -->
<section class="max-w-7xl mx-auto px-6 py-12 mb-20">
  <div class="bg-[#8EBEA2] rounded-[3rem] p-8 md:p-12 lg:p-16 flex flex-col lg:flex-row items-center justify-between gap-12 overflow-hidden">
    
    <!-- Left Text Column -->
    <div class="flex-1 max-w-xl text-left z-10">
      <div class="inline-flex items-center gap-2 bg-white/30 text-white text-xs font-bold px-4 py-2 rounded-full mb-6 uppercase tracking-wide">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
        </svg>
        Fast Delivery
      </div>

      <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-white leading-tight mb-6">
        Order Pet Foods<br/>Online
      </h2>
      
      <p class="text-white/90 text-lg font-medium leading-relaxed mb-8 max-w-md">
        No time to visit? Get your pet's favourite food delivered straight to your door, fresh and fast!
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#" class="bg-[#00B14F] text-white font-bold px-6 py-3.5 rounded-xl hover:bg-green-700 transition shadow-sm">
          Order via Uber Eats
        </a>
        <a href="#" class="bg-[#FFC107] text-black font-bold px-6 py-3.5 rounded-xl hover:bg-yellow-500 transition shadow-sm">
          Order via PickMe
        </a>
      </div>
    </div>

    <!-- Right Image Column -->
    <div class="flex-1 w-full max-w-md lg:max-w-none relative z-10 lg:ml-auto">
      <!-- Offset Background Shadow Shape -->
      <div class="absolute inset-0 bg-[#747071] rounded-[2.5rem] transform translate-x-4 translate-y-6 lg:translate-x-6 lg:translate-y-8"></div>
      
      <!-- Foreground Image -->
      <img 
        src={frenchBulldogImg.src} 
        alt="French bulldog wearing a yellow hoodie" 
        class="relative z-10 w-full h-auto object-cover rounded-[2.5rem]"
      />
    </div>

  </div>
</section>

<!-- Adopt a Loving Companion Section -->
<section class="max-w-7xl mx-auto px-6 py-12 mb-20">
  <div class="bg-[#B67B5E] rounded-[3rem] py-16 px-6 md:px-12 text-center flex flex-col items-center">
    
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
      Adopt a Loving Companion
    </h2>
    
    <p class="text-white/95 text-lg md:text-xl font-medium max-w-4xl mx-auto mb-12 leading-relaxed">
      Looking for a new best friend? We have adorable puppies, playful kittens, chirpy birds, 
      and cuddly hamsters, all waiting for a loving home.
    </p>

    <!-- Features List -->
    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-6">
      
      <!-- Feature 1 -->
      <div class="flex items-center gap-2.5 bg-white/20 px-6 py-3 rounded-full text-white font-semibold text-sm md:text-base backdrop-blur-sm border border-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Health-checked
      </div>
      
      <!-- Feature 2 -->
      <div class="flex items-center gap-2.5 bg-white/20 px-6 py-3 rounded-full text-white font-semibold text-sm md:text-base backdrop-blur-sm border border-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Clean environments
      </div>
      
      <!-- Feature 3 -->
      <div class="flex items-center gap-2.5 bg-white/20 px-6 py-3 rounded-full text-white font-semibold text-sm md:text-base backdrop-blur-sm border border-white/10">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Well-socialized
      </div>

    </div>

  </div>
</section>

<!-- Why Shop With Us Section -->
<section class="bg-[#F2F2F2] py-20 px-6">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold text-black mb-4">
        Why Shop With Us?
      </h2>
      <p class="text-gray-800 text-lg font-medium">
        We provide the best care and products for your beloved pets.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="bg-white rounded-[2rem] p-8 flex flex-col items-center justify-center text-center shadow-[0_8px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_25px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-1">
          
          <!-- Icon Circle -->
          <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-6">
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke-width="2" 
              stroke="currentColor" 
              class={`w-8 h-8 ${feature.iconColor}`}
              set:html={feature.iconPath}
            />
          </div>

          <!-- Feature Text -->
          <h3 
            class="text-[17px] font-bold text-black leading-snug"
            set:html={feature.title}
          />
        </div>
      ))}
    </div>

  </div>
</section>

<section class="max-w-7xl mx-auto px-6 py-12 mb-20">
  <div class="bg-[#203133] rounded-[2.5rem] p-8 md:p-14 lg:p-16 flex flex-col md:flex-row items-center justify-between gap-12">
    
    <div class="flex-1 max-w-xl text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Visit Us Today!
      </h2>
      <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-10 max-w-md">
        Come experience the joy of pet parenting at P & P Pet Shop. Whether you're browsing or buying, you're always welcome.
      </p>

      <div class="flex flex-col gap-6">
        
        <div class="flex items-center gap-4 group cursor-default">
          <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[#E67E22]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <span class="text-gray-100 font-medium text-sm md:text-base">
            No 22, Galle Road, Mount Lavinia
          </span>
        </div>

        <a href="tel:+94773405315" class="flex items-center gap-4 group w-max">
          <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[#27AE60]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
          </div>
          <span class="text-gray-100 font-medium text-sm md:text-base group-hover:text-white transition-colors">
            +94 77 340 5315
          </span>
        </a>

        <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group w-max">
          <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[#5DADE2]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
          </div>
          <span class="text-gray-100 font-medium text-sm md:text-base group-hover:text-white transition-colors">
            Follow us on Facebook
          </span>
        </a>

      </div>
    </div>

    <div class="flex-shrink-0 lg:mr-8 mt-8 md:mt-0">
      <img 
        src={yellowLogo.src} 
        alt="P&P Pet Shop Yellow Logo" 
        class="w-48 h-48 md:w-56 md:h-56 object-contain rounded-3xl shadow-lg"
      />
    </div>

  </div>
</section> 
    </main>
    <!-- Footer correctly placed here -->
    <Footer />
  </body>
  
</html>