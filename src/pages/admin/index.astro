---
import '../../styles/global.css';
import logo from '../../assets/100002.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - P&P Pet Shop</title>
  </head>
  <body class="bg-gray-100 font-sans text-gray-900 min-h-screen">
    <!-- Admin Topbar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40 px-6 py-3.5 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-3">
        <img src={logo.src} alt="P&P Logo" class="w-8 h-8" />
        <span class="font-extrabold text-lg tracking-tight">
          <span class="text-[#9b2a26]">P&P</span> Pet Shop <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded font-mono font-semibold ml-1">Admin</span>
        </span>
      </div>

      <div class="flex items-center gap-4">
        <a href="/" target="_blank" class="text-xs text-gray-500 hover:text-black font-semibold flex items-center gap-1">
          <span>View Live Site</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button id="admin-logout-btn" class="bg-gray-100 hover:bg-red-50 hover:text-red-600 text-gray-700 text-xs font-bold px-3 py-1.5 rounded-lg transition">
          Logout
        </button>
      </div>
    </header>

    <!-- Main Admin Container -->
    <div class="max-w-7xl mx-auto px-6 py-8">
      <!-- Tabs Navigation -->
      <div class="flex gap-2 overflow-x-auto pb-4 mb-6 border-b border-gray-200" id="admin-tabs">
        <button class="tab-btn bg-[#D9782D] text-white px-5 py-2.5 rounded-xl text-xs font-bold transition shadow-sm" data-tab="dashboard">
          Overview
        </button>
        <button class="tab-btn bg-white hover:bg-gray-50 text-gray-700 px-5 py-2.5 rounded-xl text-xs font-bold transition border border-gray-200" data-tab="orders">
          Orders & Fulfillment
        </button>
        <button class="tab-btn bg-white hover:bg-gray-50 text-gray-700 px-5 py-2.5 rounded-xl text-xs font-bold transition border border-gray-200" data-tab="products">
          Products & Catalogue
        </button>
        <button class="tab-btn bg-white hover:bg-gray-50 text-gray-700 px-5 py-2.5 rounded-xl text-xs font-bold transition border border-gray-200" data-tab="inventory">
          Inventory
        </button>
        <button class="tab-btn bg-white hover:bg-gray-50 text-gray-700 px-5 py-2.5 rounded-xl text-xs font-bold transition border border-gray-200" data-tab="uber">
          Uber Eats Integration
        </button>
      </div>

      <!-- TAB 1: OVERVIEW -->
      <section id="tab-dashboard" class="tab-content space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Total Orders</span>
            <span id="metric-orders" class="text-3xl font-black text-gray-900">-</span>
            <span id="metric-pending" class="text-xs text-orange-600 font-bold block mt-2">0 pending action</span>
          </div>
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Total Revenue</span>
            <span id="metric-revenue" class="text-3xl font-black text-[#00B14F]">-</span>
            <span class="text-xs text-gray-400 font-medium block mt-2">Paid orders (LKR)</span>
          </div>
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Active Products</span>
            <span id="metric-products" class="text-3xl font-black text-gray-900">-</span>
            <span id="metric-lowstock" class="text-xs text-red-500 font-bold block mt-2">0 low stock alerts</span>
          </div>
          <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Uber Eats Status</span>
            <span id="metric-uber" class="text-xl font-black text-gray-900">Connected</span>
            <span id="metric-uber-synced" class="text-xs text-gray-500 font-medium block mt-2">0 synced products</span>
          </div>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
          <h3 class="font-bold text-base text-gray-900 mb-4">Recent Uber Eats Synchronization Activity</h3>
          <div id="recent-logs-table" class="space-y-2 text-xs text-gray-600">
            <!-- Populated dynamically -->
          </div>
        </div>
      </section>

      <!-- TAB 2: ORDERS -->
      <section id="tab-orders" class="tab-content hidden space-y-4">
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <h3 class="font-bold text-lg text-gray-900">Customer Orders</h3>
            <div class="flex items-center gap-3">
              <input type="text" id="order-search" placeholder="Search order / customer..." class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2 text-xs focus:outline-none focus:border-[#D9782D]" />
              <select id="order-filter-status" class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-semibold focus:outline-none focus:border-[#D9782D]">
                <option value="">All Statuses</option>
                <option value="PENDING">PENDING</option>
                <option value="CONFIRMED">CONFIRMED</option>
                <option value="PREPARING">PREPARING</option>
                <option value="DELIVERED">DELIVERED</option>
                <option value="CANCELLED">CANCELLED</option>
              </select>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider font-semibold border-b border-gray-200">
                <tr>
                  <th class="py-3 px-4">Order #</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Customer</th>
                  <th class="py-3 px-4">Total (LKR)</th>
                  <th class="py-3 px-4">Payment</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="orders-tbody" class="divide-y divide-gray-100 font-medium">
                <!-- Populated dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 3: PRODUCTS -->
      <section id="tab-products" class="tab-content hidden space-y-4">
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
          <div class="flex justify-between items-center mb-6">
            <h3 class="font-bold text-lg text-gray-900">Product Catalogue</h3>
            <button id="add-product-modal-btn" class="bg-[#D9782D] hover:bg-[#b86120] text-white text-xs font-bold px-4 py-2.5 rounded-xl transition shadow-sm">
              + Add New Product
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider font-semibold border-b border-gray-200">
                <tr>
                  <th class="py-3 px-4">Item</th>
                  <th class="py-3 px-4">Category</th>
                  <th class="py-3 px-4">SKU</th>
                  <th class="py-3 px-4">Price (LKR)</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="products-tbody" class="divide-y divide-gray-100 font-medium">
                <!-- Populated dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 4: INVENTORY -->
      <section id="tab-inventory" class="tab-content hidden space-y-4">
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
          <h3 class="font-bold text-lg text-gray-900 mb-6">Stock & Inventory Controls</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider font-semibold border-b border-gray-200">
                <tr>
                  <th class="py-3 px-4">Product Name</th>
                  <th class="py-3 px-4">SKU</th>
                  <th class="py-3 px-4">On Hand</th>
                  <th class="py-3 px-4">Reserved</th>
                  <th class="py-3 px-4">Available</th>
                  <th class="py-3 px-4">Reorder Level</th>
                  <th class="py-3 px-4 text-right">Quick Stock Update</th>
                </tr>
              </thead>
              <tbody id="inventory-tbody" class="divide-y divide-gray-100 font-medium">
                <!-- Populated dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 5: UBER EATS -->
      <section id="tab-uber" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-4">
            <div>
              <h3 class="font-bold text-lg text-gray-900">Uber Eats Integration Status</h3>
              <p class="text-xs text-gray-500">Official Merchant Catalogue & Availability Synchronization</p>
            </div>
            <div class="flex items-center gap-2">
              <span id="uber-status-badge" class="bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full">
                ACTIVE
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100">
              <span class="text-gray-400 block font-medium">Store ID</span>
              <span id="uber-store-id-text" class="font-mono font-bold text-gray-900 block mt-1">store-pandp-mt-lavinia</span>
            </div>
            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100">
              <span class="text-gray-400 block font-medium">API Environment</span>
              <span id="uber-env-text" class="font-bold text-gray-900 block mt-1">sandbox</span>
            </div>
            <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100">
              <span class="text-gray-400 block font-medium">Order Injection Capability</span>
              <span class="font-bold text-gray-900 block mt-1">Ready (Awaiting Merchant Agreement)</span>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap gap-3">
            <button id="uber-sync-all-btn" class="bg-[#00B14F] hover:bg-green-700 text-white text-xs font-bold px-5 py-3 rounded-xl transition shadow-sm">
              Trigger Full Sync (Catalog + Price + Stock)
            </button>
            <button id="uber-sync-price-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold px-4 py-3 rounded-xl transition">
              Sync Prices Only
            </button>
            <button id="uber-sync-stock-btn" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold px-4 py-3 rounded-xl transition">
              Sync Inventory Only
            </button>
          </div>
          <div id="sync-feedback" class="hidden text-xs font-semibold p-3 rounded-xl"></div>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-sm">
          <h3 class="font-bold text-base text-gray-900 mb-4">Uber Item Mappings</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider font-semibold border-b border-gray-200">
                <tr>
                  <th class="py-3 px-4">Website Product</th>
                  <th class="py-3 px-4">Uber Item ID</th>
                  <th class="py-3 px-4">Uber Price</th>
                  <th class="py-3 px-4">Availability</th>
                  <th class="py-3 px-4">Last Synced</th>
                </tr>
              </thead>
              <tbody id="uber-mappings-tbody" class="divide-y divide-gray-100 font-medium">
                <!-- Populated dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>

    <!-- Login Modal (if unauthenticated) -->
    <div id="login-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl border border-gray-100 text-center space-y-6">
        <div>
          <img src={logo.src} alt="P&P Logo" class="w-12 h-12 mx-auto mb-2" />
          <h2 class="text-xl font-extrabold text-gray-900">Administrator Login</h2>
          <p class="text-xs text-gray-500 mt-1">Please sign in to access store controls</p>
        </div>

        <form id="admin-login-form" class="space-y-4 text-left">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1">Username / Email</label>
            <input type="text" id="admin-username" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#D9782D]" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1">Password</label>
            <input type="password" id="admin-password" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#D9782D]" />
          </div>
          <div id="login-error" class="hidden text-xs text-red-600 font-semibold bg-red-50 p-2 rounded-lg text-center"></div>
          <button type="submit" class="w-full bg-[#D9782D] hover:bg-[#b86120] text-white font-bold py-3 rounded-xl transition shadow-sm text-xs">
            Sign In to Dashboard
          </button>
        </form>
      </div>
    </div>
  </body>
</html>

<script>
  import { apiRequest } from '../../scripts/api';

  function checkAuth() {
    const token = localStorage.getItem('pandp_admin_token');
    const modal = document.getElementById('login-modal');
    if (!token) {
      modal?.classList.remove('hidden');
    } else {
      modal?.classList.add('hidden');
      loadDashboardData();
    }
  }

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const tabId = target.dataset.tab;

      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('bg-[#D9782D]', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      });
      target.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      target.classList.add('bg-[#D9782D]', 'text-white', 'shadow-sm');

      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      document.getElementById(`tab-${tabId}`)?.classList.remove('hidden');

      if (tabId === 'orders') loadOrders();
      if (tabId === 'products') loadProducts();
      if (tabId === 'inventory') loadInventory();
      if (tabId === 'uber') loadUberData();
    });
  });

  async function loadDashboardData() {
    const res = await apiRequest('/admin/dashboard');
    if (res.success && res.data) {
      const m = res.data.metrics;
      document.getElementById('metric-orders')!.textContent = m.total_orders;
      document.getElementById('metric-pending')!.textContent = `${m.pending_orders} pending action`;
      document.getElementById('metric-revenue')!.textContent = m.total_revenue_formatted;
      document.getElementById('metric-products')!.textContent = m.total_products;
      document.getElementById('metric-lowstock')!.textContent = `${m.low_stock_products} low stock alerts`;
      document.getElementById('metric-uber-synced')!.textContent = `${m.uber_synced_products} synced products`;

      const logsTable = document.getElementById('recent-logs-table');
      if (logsTable) {
        logsTable.innerHTML = (res.data.recent_sync_logs || []).map((log: any) => `
          <div class="flex justify-between items-center py-1.5 border-b border-gray-100 last:border-none">
            <div>
              <span class="font-bold text-gray-800">[${log.sync_type}]</span>
              <span class="text-gray-500">Processed: ${log.items_processed}, Updated: ${log.items_updated}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-semibold ${log.status === 'SUCCESS' ? 'text-green-600' : 'text-red-500'}">${log.status}</span>
              <span class="text-gray-400">${log.started_at}</span>
            </div>
          </div>
        `).join('') || '<p class="text-gray-400">No recent synchronization events recorded.</p>';
      }
    }
  }

  async function loadOrders() {
    const res = await apiRequest('/admin/orders');
    const tbody = document.getElementById('orders-tbody');
    if (res.success && res.data && tbody) {
      tbody.innerHTML = res.data.map((o: any) => `
        <tr class="hover:bg-gray-50">
          <td class="py-3 px-4 font-mono font-bold">${o.order_number}</td>
          <td class="py-3 px-4 text-gray-500">${o.created_at}</td>
          <td class="py-3 px-4 text-gray-900">${o.customer_name} <span class="text-gray-400 block">${o.customer_phone}</span></td>
          <td class="py-3 px-4 font-black">Rs. ${parseFloat(o.total_amount).toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
          <td class="py-3 px-4">${o.payment_method}</td>
          <td class="py-3 px-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase ${getStatusClass(o.website_order_status)}">${o.website_order_status}</span>
          </td>
          <td class="py-3 px-4 text-right">
            <select class="order-status-change bg-white border border-gray-200 rounded-lg p-1 text-xs" data-id="${o.id}">
              <option value="PENDING" ${o.website_order_status === 'PENDING' ? 'selected' : ''}>PENDING</option>
              <option value="CONFIRMED" ${o.website_order_status === 'CONFIRMED' ? 'selected' : ''}>CONFIRMED</option>
              <option value="PREPARING" ${o.website_order_status === 'PREPARING' ? 'selected' : ''}>PREPARING</option>
              <option value="READY_FOR_PICKUP" ${o.website_order_status === 'READY_FOR_PICKUP' ? 'selected' : ''}>READY_FOR_PICKUP</option>
              <option value="DELIVERED" ${o.website_order_status === 'DELIVERED' ? 'selected' : ''}>DELIVERED</option>
              <option value="CANCELLED" ${o.website_order_status === 'CANCELLED' ? 'selected' : ''}>CANCELLED</option>
            </select>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll('.order-status-change').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          const target = e.currentTarget as HTMLSelectElement;
          const orderId = target.dataset.id;
          const newStatus = target.value;
          await apiRequest(`/admin/orders/${orderId}`, {
            method: 'PATCH',
            body: JSON.stringify({ status: newStatus })
          });
          loadOrders();
        });
      });
    }
  }

  function getStatusClass(status: string) {
    if (status === 'CONFIRMED' || status === 'DELIVERED') return 'bg-green-100 text-green-800';
    if (status === 'PREPARING' || status === 'READY_FOR_PICKUP') return 'bg-blue-100 text-blue-800';
    if (status === 'CANCELLED' || status === 'REJECTED') return 'bg-red-100 text-red-800';
    return 'bg-amber-100 text-amber-800';
  }

  async function loadProducts() {
    const res = await apiRequest('/admin/products');
    const tbody = document.getElementById('products-tbody');
    if (res.success && res.data && tbody) {
      tbody.innerHTML = res.data.map((p: any) => `
        <tr class="hover:bg-gray-50">
          <td class="py-3 px-4 font-bold text-gray-900">${p.name}</td>
          <td class="py-3 px-4 text-gray-500">${p.category_name}</td>
          <td class="py-3 px-4 font-mono text-gray-400">${p.sku}</td>
          <td class="py-3 px-4 font-black">Rs. ${parseFloat(p.base_price).toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${p.is_active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}">
              ${p.is_active ? 'ACTIVE' : 'INACTIVE'}
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <a href="/shop/${p.slug}" target="_blank" class="text-[#D9782D] hover:underline font-bold">View</a>
          </td>
        </tr>
      `).join('');
    }
  }

  async function loadInventory() {
    const res = await apiRequest('/admin/inventory');
    const tbody = document.getElementById('inventory-tbody');
    if (res.success && res.data && tbody) {
      tbody.innerHTML = res.data.map((i: any) => `
        <tr class="hover:bg-gray-50">
          <td class="py-3 px-4 font-bold">${i.product_name} ${i.variant_name ? `<span class="text-gray-400">(${i.variant_name})</span>` : ''}</td>
          <td class="py-3 px-4 font-mono text-gray-400">${i.product_sku}</td>
          <td class="py-3 px-4 font-bold text-gray-900">${i.quantity_on_hand}</td>
          <td class="py-3 px-4 text-gray-500">${i.quantity_reserved}</td>
          <td class="py-3 px-4 font-black text-green-700">${i.quantity_on_hand - i.quantity_reserved}</td>
          <td class="py-3 px-4 text-gray-400">${i.reorder_level}</td>
          <td class="py-3 px-4 text-right">
            <input type="number" class="inv-update-input w-16 p-1 border border-gray-200 rounded text-center" value="${i.quantity_on_hand}" data-id="${i.id}" />
            <button class="inv-save-btn bg-gray-900 text-white px-2 py-1 rounded ml-1 text-[11px]" data-id="${i.id}">Save</button>
          </td>
        </tr>
      `).join('');

      tbody.querySelectorAll('.inv-save-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const t = e.currentTarget as HTMLElement;
          const id = t.dataset.id;
          const input = tbody.querySelector(`.inv-update-input[data-id="${id}"]`) as HTMLInputElement;
          if (input) {
            await apiRequest(`/admin/inventory/${id}`, {
              method: 'PATCH',
              body: JSON.stringify({ quantity_on_hand: parseInt(input.value, 10) })
            });
            loadInventory();
          }
        });
      });
    }
  }

  async function loadUberData() {
    const res = await apiRequest('/admin/uber/mappings');
    const tbody = document.getElementById('uber-mappings-tbody');
    if (res.success && res.data && tbody) {
      tbody.innerHTML = res.data.map((m: any) => `
        <tr class="hover:bg-gray-50">
          <td class="py-3 px-4 font-bold">${m.product_name}</td>
          <td class="py-3 px-4 font-mono text-gray-500">${m.uber_item_id}</td>
          <td class="py-3 px-4 font-bold">Rs. ${parseFloat(m.uber_price).toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${m.uber_is_available ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
              ${m.uber_is_available ? 'AVAILABLE' : 'OUT_OF_STOCK'}
            </span>
          </td>
          <td class="py-3 px-4 text-gray-400">${m.last_synced_at || 'Never'}</td>
        </tr>
      `).join('') || '<tr><td colspan="5" class="py-4 text-center text-gray-400">No Uber mappings established yet. Trigger sync to match items.</td></tr>';
    }
  }

  // Trigger Uber Sync Buttons
  document.getElementById('uber-sync-all-btn')?.addEventListener('click', async () => {
    const feedback = document.getElementById('sync-feedback');
    if (feedback) {
      feedback.textContent = 'Triggering synchronization with Uber Eats...';
      feedback.className = 'text-xs font-semibold p-3 rounded-xl bg-blue-50 text-blue-700 block';
    }
    const res = await apiRequest('/admin/uber/sync', { method: 'POST', body: JSON.stringify({ type: 'ALL' }) });
    if (feedback) {
      feedback.textContent = res.message || 'Sync completed successfully!';
      feedback.className = 'text-xs font-semibold p-3 rounded-xl bg-green-50 text-green-700 block';
    }
    loadUberData();
  });

  // Admin login form handler
  document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const u = (document.getElementById('admin-username') as HTMLInputElement).value;
    const p = (document.getElementById('admin-password') as HTMLInputElement).value;
    const err = document.getElementById('login-error');

    const res = await apiRequest('/admin/auth/login', {
      method: 'POST',
      body: JSON.stringify({ username: u, password: p })
    });

    if (res.success && res.data?.token) {
      localStorage.setItem('pandp_admin_token', res.data.token);
      document.getElementById('login-modal')?.classList.add('hidden');
      loadDashboardData();
    } else {
      if (err) {
        err.textContent = res.message || 'Invalid username or password.';
        err.classList.remove('hidden');
      }
    }
  });

  document.getElementById('admin-logout-btn')?.addEventListener('click', () => {
    localStorage.removeItem('pandp_admin_token');
    window.location.reload();
  });

  document.addEventListener('DOMContentLoaded', checkAuth);
</script>

